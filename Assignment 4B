#include <stdio.h>
int main()
{

int A[2][2], B[2][2], C[2][2];
int i, j;
printf("Enter the measurements for the first biological samples:\n");
for(i=0;i < 2;i++)
{
for(j=0;j < 2;j++)
{
scanf("%d", &A[i][j]);
}
}
printf("Enter the measurements for the second biological samples:\n");
for(i=0;i < 2;i++)
{
for(j=0;j < 2;j++)
{
scanf("%d", &B[i][j]);
}
}
for(i=0;i < 2;i++)
{
for(j=0;j < 2;j++)
{
C[i][j] = A[i][j] + B[i][j];
}
}
printf("\nResultant Measurement Matrix:\n");
for(i=0;i < 2;i++)
{
for(j=0;j < 2;j++)
{
printf("%d\t", C[i][j]);
}
printf("\n");
}
return 0;
}
